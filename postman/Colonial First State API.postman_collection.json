              "raw": "{\n  \"username\": \"{{admin_auth_username}}\",\n  \"password\": \"{{admin_auth_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
