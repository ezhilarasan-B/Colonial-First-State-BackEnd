    },
    {
      "key": "admin_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token populated automatically by pre-request script or login endpoint"
    },
    {
      "key": "admin_refresh_token",
      "value": "",
      "type": "string",
      "description": "JWT refresh token populated automatically by pre-request script or login endpoint"
    },
    {
      "key": "admin_token_expiry",
      "value": "",
      "type": "string",
      "description": "Unix epoch timestamp in seconds indicating token expiration"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints for obtaining and rotating JWT access & refresh tokens.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains access token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    var token = jsonData.accessToken || jsonData.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set(\"admin_access_token\", token);",
                  "        if (pm.environment) {",
                  "            pm.environment.set(\"admin_access_token\", token);",
                  "        }",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set(\"admin_refresh_token\", jsonData.refreshToken);",
                  "        if (pm.environment) {",
                  "            pm.environment.set(\"admin_refresh_token\", jsonData.refreshToken);",
                  "        }",
                  "    }",
                  "    if (jsonData.expiresIn) {",
                  "        var expiry = Math.floor(Date.now() / 1000) + jsonData.expiresIn;",
                  "        pm.collectionVariables.set(\"admin_token_expiry\", expiry.toString());",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
