{
  "info": {
    "_postman_id": "b80e6eff-36d7-4bb8-be7b-8f15de048cb5",
    "name": "Colonial First State API",
    "description": "Complete Postman collection for the Colonial First State (CFS) Staff Directory REST API.\n\n### Features\n- Automated JWT Bearer authentication via collection Pre-request Script using Admin credentials (`admin` / `Password123!`).\n- Caches token and token expiry to avoid redundant authentication requests.\n- Exception handling on the Auth/Login endpoint prevents recursive execution.\n- Full CRUD support for Staff Directory and Client management, plus dual-route `/api/users` compatibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "// Pre-request Script for Colonial First State API (Admin)",
          "var currentRequestName = pm.info.requestName || '';",
          "var currentUrl = (pm.request && pm.request.url) ? pm.request.url.toString() : '';",
          "",
          "// 1. Skip pre-request authentication for Auth/Login request itself to prevent recursion",
          "if (currentRequestName === 'Login' || currentUrl.indexOf('/api/auth/login') !== -1) {",
          "    return;",
          "}",
          "",
          "var baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:5200';",
          "var username = pm.collectionVariables.get('auth_username') || 'admin';",
          "var password = pm.collectionVariables.get('auth_password') || 'Password123!';",
          "var accessToken = pm.collectionVariables.get('accessToken') || (pm.environment ? pm.environment.get('accessToken') : null);",
          "var tokenExpiry = pm.collectionVariables.get('tokenExpiry');",
          "var currentTime = Math.floor(Date.now() / 1000);",
          "",
          "// Helper function to check if token exists and is not expired (with 30-second buffer)",
          "function isTokenValid(token, expiry) {",
          "    if (!token || token.trim() === '') return false;",
          "    if (expiry) {",
          "        return currentTime < (parseInt(expiry, 10) - 30);",
          "    }",
          "    try {",
          "        var parts = token.split('.');",
          "        if (parts.length === 3) {",
          "            var payloadStr = atob(parts[1].replace(/-/g, '+').replace(/_/g, '/'));",
          "            var payload = JSON.parse(payloadStr);",
          "            if (payload && payload.exp) {",
          "                return currentTime < (payload.exp - 30);",
          "            }",
          "        }",
          "    } catch (e) {}",
          "    return false;",
          "}",
          "",
          "// 2. If existing token is still valid, proceed with the request",
          "if (isTokenValid(accessToken, tokenExpiry)) {",
          "    return;",
          "}",
          "",
          "// 3. Otherwise, obtain a fresh token from Auth/Login endpoint",
          "var authRequest = {",
          "    url: baseUrl + '/api/auth/login',",
          "    method: 'POST',",
          "    header: {",
          "        'Content-Type': 'application/json',",
          "        'Accept': 'application/json'",
          "    },",
          "    body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "            username: username,",
          "            password: password",
          "        })",
          "    }",
          "};",
          "",
          "pm.sendRequest(authRequest, function (err, res) {",
          "    if (err) {",
          "        console.error('[Pre-request] Authentication call failed:', err);",
          "        return;",
          "    }",
          "    if (res.code === 200) {",
          "        var data = res.json();",
          "        var token = data.accessToken || data.token;",
          "        var refreshToken = data.refreshToken;",
          "        var expiresIn = data.expiresIn || 900;",
          "        var expiryTimestamp = (Math.floor(Date.now() / 1000) + expiresIn).toString();",
          "        if (token) {",
          "            pm.collectionVariables.set('accessToken', token);",
          "            pm.collectionVariables.set('tokenExpiry', expiryTimestamp);",
          "            if (pm.environment) {",
          "                pm.environment.set('accessToken', token);",
          "            }",
          "            console.log('[Pre-request] Obtained new access token for ' + username + '.');",
          "        }",
          "        if (refreshToken) {",
          "            pm.collectionVariables.set('refreshToken', refreshToken);",
          "            if (pm.environment) {",
          "                pm.environment.set('refreshToken', refreshToken);",
          "            }",
          "        }",
          "    } else {",
          "        console.error('[Pre-request] Authentication failed. Status:', res.code, res.text());",
          "    }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5200",
      "type": "string",
      "description": "Base URL of the .NET 8 Web API backend (e.g., http://localhost:5200 or https://localhost:7001)"
