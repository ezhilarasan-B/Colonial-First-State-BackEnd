{
  "info": {
    "_postman_id": "a66932dd-e7e8-4432-95e8-8d2d3920eb7d",
    "name": "Colonial First State Readonly API",
    "description": "Read-only Postman collection for the Colonial First State (CFS) Staff Directory REST API.\n\n### Features\n- Automated JWT Bearer authentication via collection Pre-request Script using Read-Only user credentials (`readuser` / `Password123!`).\n- Caches token and token expiry to avoid redundant authentication requests.\n- Exception handling on the Auth/Login endpoint prevents recursive execution.\n- Strictly includes endpoints/actions that the readonly user is authorized to access (Read / GET operations). Destructive/write actions restricted from `StaffReadOnly` role are excluded.\n- Route versioning under `/api/v1/`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{readonly_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script for Colonial First State Readonly API (Read-Only User)",
          "var currentRequestName = pm.info.requestName || '';",
          "var currentUrl = (pm.request && pm.request.url) ? pm.request.url.toString() : '';",
          "",
          "// 1. Skip pre-request authentication for Auth/Login request itself to prevent recursion",
          "if (currentRequestName === 'Login' || currentUrl.indexOf('/api/v1/auth/login') !== -1 || currentUrl.indexOf('/api/auth/login') !== -1) {",
          "    return;",
          "}",
          "",
          "var baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:5200';",
          "var username = pm.collectionVariables.get('readonly_auth_username') || pm.collectionVariables.get('auth_username') || 'readuser';",
          "var password = pm.collectionVariables.get('readonly_auth_password') || pm.collectionVariables.get('auth_password') || 'Password123!';",
          "var accessToken = pm.collectionVariables.get('readonly_access_token') || (pm.environment ? pm.environment.get('readonly_access_token') : null);",
          "var tokenExpiry = pm.collectionVariables.get('readonly_token_expiry');",
          "var currentTime = Math.floor(Date.now() / 1000);",
          "",
          "// Helper function to check if token exists and is not expired (with 30-second buffer)",
          "function isTokenValid(token, expiry) {",
          "    if (!token || token.trim() === '') return false;",
          "    if (expiry) {",
          "        return currentTime < (parseInt(expiry, 10) - 30);",
          "    }",
          "    try {",
          "        var parts = token.split('.');",
          "        if (parts.length === 3) {",
          "            var payloadStr = atob(parts[1].replace(/-/g, '+').replace(/_/g, '/'));",
          "            var payload = JSON.parse(payloadStr);",
          "            if (payload && payload.exp) {",
          "                return currentTime < (payload.exp - 30);",
          "            }",
          "        }",
          "    } catch (e) {}",
          "    return false;",
          "}",
          "",
          "// 2. If existing token is still valid, proceed with the request",
          "if (isTokenValid(accessToken, tokenExpiry)) {",
          "    return;",
          "}",
          "",
          "// 3. Otherwise, obtain a fresh token from Auth/Login endpoint",
          "var authRequest = {",
          "    url: baseUrl + '/api/v1/auth/login',",
          "    method: 'POST',",
          "    header: {",
          "        'Content-Type': 'application/json',",
          "        'Accept': 'application/json'",
          "    },",
          "    body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "            username: username,",
          "            password: password",
          "        })",
          "    }",
          "};",
          "",
          "pm.sendRequest(authRequest, function (err, res) {",
          "    if (err) {",
          "        console.error('[Pre-request] Authentication call failed:', err);",
          "        return;",
          "    }",
          "    if (res.code === 200) {",
          "        var data = res.json();",
          "        var token = data.accessToken || data.token;",
          "        var refreshToken = data.refreshToken;",
          "        var expiresIn = data.expiresIn || 900;",
          "        var expiryTimestamp = (Math.floor(Date.now() / 1000) + expiresIn).toString();",
          "        if (token) {",
          "            pm.collectionVariables.set('readonly_access_token', token);",
          "            pm.collectionVariables.set('readonly_token_expiry', expiryTimestamp);",
          "            if (pm.environment) {",
          "                pm.environment.set('readonly_access_token', token);",
          "            }",
          "            console.log('[Pre-request] Obtained new access token for ' + username + '.');",
          "        }",
          "        if (refreshToken) {",
          "            pm.collectionVariables.set('readonly_refresh_token', refreshToken);",
          "            if (pm.environment) {",
          "                pm.environment.set('readonly_refresh_token', refreshToken);",
          "            }",
          "        }",
          "    } else {",
          "        console.error('[Pre-request] Authentication failed. Status:', res.code, res.text());",
          "    }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5200",
      "type": "string",
      "description": "Base URL of the .NET 8 Web API backend (e.g., http://localhost:5200 or https://localhost:7001)"
    },
    {
      "key": "readonly_auth_username",
      "value": "readuser",
      "type": "string",
      "description": "Read-only staff username configured in the project"
    },
    {
      "key": "readonly_auth_password",
      "value": "Password123!",
      "type": "string",
      "description": "Read-only staff password configured in the project"
    },
    {
      "key": "readonly_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token populated automatically by pre-request script or login endpoint for read-only user"
    },
    {
      "key": "readonly_refresh_token",
      "value": "",
      "type": "string",
      "description": "JWT refresh token populated automatically by pre-request script or login endpoint for read-only user"
    },
    {
      "key": "readonly_token_expiry",
      "value": "",
      "type": "string",
      "description": "Unix epoch timestamp in seconds indicating token expiration"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints for obtaining and rotating JWT access & refresh tokens.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains access token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    var token = jsonData.accessToken || jsonData.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set(\"readonly_access_token\", token);",
                  "        if (pm.environment) {",
                  "            pm.environment.set(\"readonly_access_token\", token);",
                  "        }",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set(\"readonly_refresh_token\", jsonData.refreshToken);",
                  "        if (pm.environment) {",
                  "            pm.environment.set(\"readonly_refresh_token\", jsonData.refreshToken);",
                  "        }",
                  "    }",
                  "    if (jsonData.expiresIn) {",
                  "        var expiry = Math.floor(Date.now() / 1000) + jsonData.expiresIn;",
                  "        pm.collectionVariables.set(\"readonly_token_expiry\", expiry.toString());",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{readonly_auth_username}}\",\n  \"password\": \"{{readonly_auth_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates read-only credentials and returns JWT access and refresh tokens. Excluded from automated pre-request script to avoid recursion."
          },
          "response": []
        },
